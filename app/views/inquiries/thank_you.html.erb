<% content_for :meta_robots, "noindex,follow" %>

<section class="section-block">
  <div class="section-shell max-w-3xl">
    <div class="card">
      <p class="pill">Message sent</p>
      <h1 class="mt-4 text-4xl font-bold text-slate-900">Thanks. I got your message.</h1>
      <p class="mt-4 text-lg text-slate-700">I will review it and reply with next steps.</p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <%= link_to "Back to home", root_path, class: "btn-secondary" %>
        <%= link_to "View case studies", work_path, class: "btn-primary" %>
      </div>
    </div>
  </div>
</section>
