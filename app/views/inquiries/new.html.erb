<% content_for :meta_title, "Ask Doug Morgen About Automation or Software Work" %>
<% content_for :meta_description, "Tell Doug Morgen about your SMB automation, Rails, Shopify, internal tools, API integration, data workflow, or technical leadership problem and get practical next steps." %>

<section class="section-block">
  <div class="section-shell">
    <div class="hero-grid">
      <div class="order-2 rise-in lg:order-1">
        <p class="pill">Start here</p>
        <h1 class="mt-5 text-4xl font-bold leading-tight text-slate-900 sm:text-5xl">Get a practical read on the workflow that is stuck.</h1>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-slate-700">Share what you are trying to automate, build, connect, clean up, or decide. I will review the context and reply with the clearest next step.</p>

        <div class="mt-8 space-y-5">
          <div class="card">
            <h2 class="text-lg font-bold text-slate-900">Best fit</h2>
            <ul class="proof-list mt-3 text-sm leading-relaxed text-slate-700">
              <li>SMBs that need to replace spreadsheet-heavy or manual operations.</li>
              <li>E-commerce teams with Shopify, fulfillment, reporting, or accounting bottlenecks.</li>
              <li>Founders and operators who need Rails, integrations, internal tools, or senior technical judgment.</li>
            </ul>
          </div>

          <div class="card">
            <h2 class="text-lg font-bold text-slate-900">What happens next</h2>
            <ol class="mt-3 space-y-2 text-sm text-slate-700">
              <li>1. I read your message and look for the real bottleneck.</li>
              <li>2. I reply with whether this looks like automation, a scoped build, cleanup, technical leadership, or a smaller first step.</li>
              <li>3. If there is a fit, we scope the work and move quickly.</li>
            </ol>
          </div>
        </div>
      </div>

      <div class="order-1 card inquiry-card rise-in lg:order-2">
        <p class="pill">Quick fit check</p>
        <h2 class="mt-4 text-2xl font-bold text-slate-900">Tell me what you need fixed.</h2>
        <p class="mt-2 text-sm leading-relaxed text-slate-600">A few clear sentences are enough. I review every message personally.</p>

        <% if @inquiry.errors.any? %>
          <div class="mt-4 rounded-xl border border-red-300 bg-red-50 p-4 text-sm text-red-800">
            <p class="font-semibold">Please fix the following:</p>
            <ul class="mt-2 list-disc pl-5">
              <% @inquiry.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <%= form_with model: @inquiry, url: inquiries_path, class: "mt-5 space-y-4" do |f| %>
          <div class="grid gap-3 sm:grid-cols-2">
            <div>
              <%= f.label :name, "Name", class: "field-label" %>
              <%= f.text_field :name, class: "field-input", autocomplete: "name", required: true %>
            </div>

            <div>
              <%= f.label :email, "Email", class: "field-label" %>
              <%= f.email_field :email, class: "field-input", autocomplete: "email", required: true %>
            </div>
          </div>

          <div>
            <%= f.label :message, "What is slowing the business down?", class: "field-label" %>
            <%= f.text_area :message, class: "field-input min-h-32", required: true, placeholder: "Example: We are doing order cleanup in spreadsheets and need Shopify, accounting, and ops to sync." %>
          </div>

          <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
            <p class="text-sm font-semibold text-slate-900">Helpful details (optional)</p>
            <div class="mt-4 space-y-4">
              <div>
                <%= f.label :company, "Company", class: "field-label" %>
                <%= f.text_field :company, class: "field-input", autocomplete: "organization" %>
              </div>

              <div>
                <%= f.label :phone, "Phone", class: "field-label" %>
                <%= f.telephone_field :phone, class: "field-input", autocomplete: "tel" %>
              </div>

              <div>
                <%= f.label :project_type, "Type of help", class: "field-label" %>
                <%= f.select :project_type, Inquiry::PROJECT_TYPES, { include_blank: "Select if useful" }, class: "field-input" %>
              </div>

              <div>
                <%= f.label :budget, "Budget range", class: "field-label" %>
                <%= f.select :budget, Inquiry::BUDGETS, { include_blank: "Select if useful" }, class: "field-input" %>
              </div>

              <div>
                <%= f.label :timeline, "Timeline", class: "field-label" %>
                <%= f.select :timeline, Inquiry::TIMELINES, { include_blank: "Select if useful" }, class: "field-input" %>
              </div>
            </div>
          </div>

          <div class="hidden" aria-hidden="true">
            <%= f.label :honeypot, "Leave this field blank" %>
            <%= f.text_field :honeypot, tabindex: "-1", autocomplete: "off" %>
          </div>

          <%= f.hidden_field :source_page, value: @inquiry.source_page.presence || "/start" %>
          <%= hidden_field_tag :form_started_at, @form_started_at %>
          <%= hidden_field_tag :form_signature, @form_signature %>

          <%= f.submit "Ask Doug to take a look", class: "btn-primary w-full" %>
        <% end %>

        <p class="mt-5 text-sm text-slate-600">Want process details before writing? <%= link_to "Read the FAQ", faq_path, class: "font-semibold text-blue-700 hover:text-blue-800" %>.</p>
      </div>
    </div>
  </div>
</section>
