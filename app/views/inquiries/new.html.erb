<% content_for :meta_title, "Ask Doug Morgen About Automation or Software Work" %>
<% content_for :meta_description, "Tell Doug Morgen about your SMB automation, Rails, Shopify, internal tools, API integration, data workflow, or technical leadership problem and get practical next steps." %>

<section class="section-block">
  <div class="section-shell">
    <div class="grid gap-10 lg:grid-cols-[1fr_1fr]">
      <div class="order-2 lg:order-1">
        <h1 class="text-4xl font-bold text-slate-900 sm:text-5xl">Tell me what you're trying to automate, build, fix, or decide.</h1>
        <p class="mt-5 text-lg text-slate-700">I work with SMBs, founders, e-commerce teams, and operators who need practical software help without a lot of ceremony.</p>

        <div class="mt-8 space-y-5">
          <div class="card">
            <h2 class="text-lg font-bold text-slate-900">Who this is for</h2>
            <ul class="mt-3 space-y-2 text-sm text-slate-700">
              <li>Teams replacing manual processes and spreadsheet workflows</li>
              <li>SMBs that need operations automation, internal tools, or better reporting</li>
              <li>Founders who need a fast prototype before hiring a full team</li>
              <li>Operators with Shopify, integration, data, or infrastructure decisions to make</li>
            </ul>
          </div>

          <div class="card">
            <h2 class="text-lg font-bold text-slate-900">Common projects</h2>
            <ul class="mt-3 space-y-2 text-sm text-slate-700">
              <li>Business process automation and internal tools</li>
              <li>Fast prototypes and MVPs</li>
              <li>Rails apps, Shopify systems, API integrations, and dashboards</li>
              <li>Data imports, cleanup, reporting, and workflow design</li>
            </ul>
          </div>

          <div class="card">
            <h2 class="text-lg font-bold text-slate-900">What happens next</h2>
            <ol class="mt-3 space-y-2 text-sm text-slate-700">
              <li>1. I review your message.</li>
              <li>2. I reply with the clearest next step and whether I can help.</li>
              <li>3. If it's a fit, we scope something practical and move.</li>
            </ol>
          </div>
        </div>
      </div>

      <div class="order-1 card lg:order-2">
        <h2 class="text-2xl font-bold text-slate-900">Tell me about the work</h2>
        <p class="mt-2 text-sm leading-relaxed text-slate-600">Share the basics here. A rough description is fine; the point is to understand what is stuck and what better would look like.</p>

        <% if @inquiry.errors.any? %>
          <div class="mt-4 rounded-xl border border-red-300 bg-red-50 p-4 text-sm text-red-800">
            <p class="font-semibold">Please fix the following:</p>
            <ul class="mt-2 list-disc pl-5">
              <% @inquiry.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <%= form_with model: @inquiry, url: inquiries_path, class: "mt-6 space-y-4" do |f| %>
          <div>
            <%= f.label :name, "Name", class: "field-label" %>
            <%= f.text_field :name, class: "field-input", autocomplete: "name", required: true %>
          </div>

          <div>
            <%= f.label :email, "Email", class: "field-label" %>
            <%= f.email_field :email, class: "field-input", autocomplete: "email", required: true %>
          </div>

          <div>
            <%= f.label :company, "Company", class: "field-label" %>
            <%= f.text_field :company, class: "field-input", autocomplete: "organization" %>
          </div>

          <div>
            <%= f.label :phone, "Phone (optional)", class: "field-label" %>
            <%= f.telephone_field :phone, class: "field-input", autocomplete: "tel" %>
          </div>

          <div>
            <%= f.label :project_type, "Type of help", class: "field-label" %>
            <%= f.select :project_type, Inquiry::PROJECT_TYPES, { include_blank: "Select type of help" }, class: "field-input" %>
          </div>

          <div>
            <%= f.label :budget, "Budget", class: "field-label" %>
            <%= f.select :budget, Inquiry::BUDGETS, { include_blank: "Select budget" }, class: "field-input" %>
          </div>

          <div>
            <%= f.label :timeline, "Timeline", class: "field-label" %>
            <%= f.select :timeline, Inquiry::TIMELINES, { include_blank: "Select timeline" }, class: "field-input" %>
          </div>

          <div>
            <%= f.label :message, "What should I know?", class: "field-label" %>
            <%= f.text_area :message, class: "field-input min-h-32", required: true, placeholder: "Example: We are doing this manually today, it is slowing down operations, and we want to automate or prototype a better workflow." %>
          </div>

          <div class="hidden" aria-hidden="true">
            <%= f.label :honeypot, "Leave this field blank" %>
            <%= f.text_field :honeypot, tabindex: "-1", autocomplete: "off" %>
          </div>

          <%= f.hidden_field :source_page, value: @inquiry.source_page.presence || "/start" %>
          <%= hidden_field_tag :form_started_at, @form_started_at %>
          <%= hidden_field_tag :form_signature, @form_signature %>

          <div>
            <%= f.submit "Send message", class: "btn-primary w-full sm:w-auto" %>
          </div>
        <% end %>
        <p class="mt-5 text-sm text-slate-600">Want details on process, timelines, and engagement formats? <%= link_to "Read the FAQ", faq_path, class: "font-semibold text-blue-700 hover:text-blue-800" %>.</p>
      </div>
    </div>
  </div>
</section>
