<% source_page = local_assigns.fetch(:source_page) { defined?(@inquiry) && @inquiry.present? && @inquiry.source_page.present? ? @inquiry.source_page : request.path } %>
<% inquiry = local_assigns.fetch(:inquiry) { defined?(@inquiry) && @inquiry.present? ? @inquiry : Inquiry.new(source_page: source_page) } %>
<% anchor_id = local_assigns[:anchor_id] %>
<% submit_label = local_assigns.fetch(:submit_label, "Get started") %>
<% intro = local_assigns.fetch(:intro, "Tell me what you want to build, automate, or fix. I will send next steps.") %>
<% form_started_at, form_signature = inquiry_form_timing_values %>

<%= tag.div id: anchor_id, class: "card inquiry-card scroll-mt-24" do %>
  <p class="pill">Start here</p>
  <h2 class="mt-4 text-2xl font-bold text-slate-900">Need help getting started?</h2>
  <p class="mt-2 text-sm leading-relaxed text-slate-600"><%= intro %></p>

  <% if inquiry.errors.any? %>
    <div class="mt-4 rounded-xl border border-red-300 bg-red-50 p-4 text-sm text-red-800">
      <p class="font-semibold">Please fix the following:</p>
      <ul class="mt-2 list-disc pl-5">
        <% inquiry.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: inquiry, url: inquiries_path, class: "mt-5 space-y-3" do |f| %>
    <div class="grid gap-3 sm:grid-cols-2">
      <div>
        <%= f.label :name, "Name", class: "field-label" %>
        <%= f.text_field :name, class: "field-input", autocomplete: "name", required: true %>
      </div>

      <div>
        <%= f.label :email, "Email", class: "field-label" %>
        <%= f.email_field :email, class: "field-input", autocomplete: "email", required: true %>
      </div>
    </div>

    <div>
      <%= f.label :message, "What do you want to build, automate, or fix?", class: "field-label" %>
      <%= f.text_area :message, class: "field-input min-h-24", required: true, placeholder: "Example: We want Shopify, accounting, and operations to stay in sync and cut down weekly admin work." %>
    </div>

    <div class="hidden" aria-hidden="true">
      <%= f.label :honeypot, "Leave this field blank" %>
      <%= f.text_field :honeypot, tabindex: "-1", autocomplete: "off" %>
    </div>

    <%= f.hidden_field :source_page, value: source_page %>
    <%= hidden_field_tag :form_started_at, form_started_at %>
    <%= hidden_field_tag :form_signature, form_signature %>

    <%= f.submit submit_label, class: "btn-primary w-full" %>
  <% end %>

  <p class="mt-4 text-xs leading-relaxed text-slate-500">Best fit: SMBs, founders, and operators who need clearer workflows, better reporting, or software that can keep up with the business.</p>
<% end %>
