<% source_page = local_assigns.fetch(:source_page, request.path) %>
<% submit_label = local_assigns.fetch(:submit_label, "Get started") %>
<% intro = local_assigns.fetch(:intro, "Share the bottleneck. I will reply with the clearest next step.") %>
<% form_started_at, form_signature = inquiry_form_timing_values %>

<div class="card inquiry-card">
  <p class="pill">Quick fit check</p>
  <h2 class="mt-4 text-2xl font-bold text-slate-900">Need help getting started?</h2>
  <p class="mt-2 text-sm leading-relaxed text-slate-600"><%= intro %></p>

  <%= form_with scope: :inquiry, url: inquiries_path, class: "mt-5 space-y-3" do |f| %>
    <div class="grid gap-3 sm:grid-cols-2">
      <div>
        <%= f.label :name, "Name", class: "field-label" %>
        <%= f.text_field :name, class: "field-input", autocomplete: "name", required: true %>
      </div>

      <div>
        <%= f.label :email, "Email", class: "field-label" %>
        <%= f.email_field :email, class: "field-input", autocomplete: "email", required: true %>
      </div>
    </div>

    <div>
      <%= f.label :message, "What is slowing the business down?", class: "field-label" %>
      <%= f.text_area :message, class: "field-input min-h-24", required: true, placeholder: "Example: We are doing order cleanup in spreadsheets and need Shopify, accounting, and ops to sync." %>
    </div>

    <div class="hidden" aria-hidden="true">
      <%= f.label :honeypot, "Leave this field blank" %>
      <%= f.text_field :honeypot, tabindex: "-1", autocomplete: "off" %>
    </div>

    <%= f.hidden_field :source_page, value: source_page %>
    <%= hidden_field_tag :form_started_at, form_started_at %>
    <%= hidden_field_tag :form_signature, form_signature %>

    <%= f.submit submit_label, class: "btn-primary w-full" %>
  <% end %>

  <p class="mt-4 text-xs leading-relaxed text-slate-500">Best fit: SMBs, founders, and operators with manual work, messy data, or software that needs to move faster.</p>
</div>
