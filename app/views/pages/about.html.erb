<% content_for :meta_title, "About Doug Morgen | Fractional CTO and Senior Software Engineer" %>
<% content_for :meta_description, "Doug Morgen is a fractional CTO, half-time CTO, and senior software engineer focused on practical Rails, Shopify, and operations systems." %>

<section class="section-block">
  <div class="section-shell max-w-4xl">
    <h1 class="text-4xl font-bold text-slate-900 sm:text-5xl">About</h1>
    <p class="mt-6 text-lg leading-relaxed text-slate-700">I'm Doug Morgen, a senior software engineer, former founder, and fractional CTO focused on practical systems that help teams operate better. I typically work as a fractional CTO, half-time CTO, or senior consultant depending on stage and urgency.</p>

    <div class="mt-8 grid gap-5 sm:grid-cols-2">
      <div class="card">
        <h2 class="text-lg font-bold text-slate-900">How I Work</h2>
        <p class="mt-3 text-slate-700">Clear scope, direct communication, and high-leverage iteration. I lead technical strategy and stay hands-on to ship meaningful outcomes quickly.</p>
      </div>
      <div class="card">
        <h2 class="text-lg font-bold text-slate-900">Where I Add Leverage</h2>
        <p class="mt-3 text-slate-700">Rails architecture, Shopify-connected systems, accounting/ops migrations, product execution, and internal tooling that removes operational friction.</p>
      </div>
    </div>

    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <%= link_to "LinkedIn", linkedin_url, target: "_blank", rel: "noopener", class: "btn-secondary" %>
      <%= link_to "Start a project", start_project_path, class: "btn-primary" %>
    </div>
  </div>
</section>
