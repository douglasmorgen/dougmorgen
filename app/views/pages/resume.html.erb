<% content_for :meta_title, "Doug Morgen Background | SMB Automation and Rails Engineer" %>
<% content_for :meta_description, "Background for Doug Morgen: SMB automation, senior Rails engineering, Shopify systems, accounting migrations, e-commerce operations, and software delivery." %>
<% content_for :meta_robots, "noindex,follow" %>

<section class="section-block">
  <div class="section-shell">
    <div class="hero-grid">
      <div class="rise-in">
        <p class="pill">Background</p>
        <h1 class="mt-5 text-4xl font-bold leading-tight text-slate-900 sm:text-5xl">Background context for businesses evaluating software help.</h1>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-slate-700">This page is here for people who want background details after they already know what kind of help they need.</p>
        <p class="mt-3 max-w-2xl text-base leading-relaxed text-slate-700">For search, the services, work, FAQ, and home pages are better landing pages, so this resume page is intentionally marked noindex.</p>

        <div class="mt-7 flex flex-col gap-3 sm:flex-row">
          <%= link_to "See services", services_path, class: "btn-secondary" %>
          <%= link_to "Connect on LinkedIn", linkedin_url, target: "_blank", rel: "noopener", class: "btn-secondary" %>
        </div>
      </div>

      <div class="rise-in">
        <%= render "inquiries/quick_form", intro: "If the background looks relevant, send the workflow or system you are trying to fix and I will tell you where I can help." %>
      </div>
    </div>
  </div>
</section>

<section class="section-block pt-0">
  <div class="section-shell max-w-4xl">
    <div class="space-y-5">
      <article class="card">
        <h2 class="text-xl font-bold text-slate-900">Core focus</h2>
        <p class="mt-3 text-slate-700">SMB automation, Rails applications, Shopify and e-commerce operations, internal tools, API integrations, data workflows, technical cleanup, and ongoing technical partnership.</p>
      </article>

      <article class="card">
        <h2 class="text-xl font-bold text-slate-900">Selected projects</h2>
        <ul class="mt-3 space-y-3 text-slate-700">
          <li><strong>Homebrand:</strong> Rails platform for property document ingestion, OCR/search, cited AI answers, and maintenance workflows.</li>
          <li><strong>ArraFund Commission Platform:</strong> Connected Rails and Shopify system for commission tracking, campaign order ingestion, webhook synchronization, and payout operations.</li>
          <li><strong>BrightGo Accounting Migration:</strong> Hybrid ERP accounting and operations system with ledger migration pipelines, strict idempotency, and penny-perfect reconciliation.</li>
          <li><strong>EasyPost Scale:</strong> Billing and logistics systems supporting billions in shipping volume and high-throughput carrier workflows.</li>
          <li><strong>Cellular Country:</strong> Built and operated an $8M/year e-commerce business with custom inventory, fulfillment, and CRM systems.</li>
        </ul>
      </article>
    </div>
  </div>
</section>
