<% content_for :meta_title, "SMB Automation and Practical Software Help FAQ | Doug Morgen" %>
<% content_for :meta_description, "Questions about hiring Doug Morgen for automation, Rails, Shopify, internal tools, data cleanup, API integrations, and senior technical help." %>
<% faq_items = [
  {
    question: "What kinds of automation projects are a fit?",
    answer: "Good fits include replacing spreadsheet workflows, connecting systems, building internal tools, automating approvals, cleaning operational data, syncing Shopify or accounting data, and improving Rails apps that run part of the business."
  },
  {
    question: "Do we need to know exactly what software to build?",
    answer: "No. Many projects start with a messy business process, not a clean feature request. I can help map the workflow, find the clearest path, and decide what should be automated first."
  },
  {
    question: "Do you work with non-technical businesses?",
    answer: "Yes. A lot of my best work is with operators who know the business well and need a technical partner to turn the workflow into software."
  },
  {
    question: "What kinds of Rails consulting projects are a fit?",
    answer: "Good fits include shipping Rails features, cleaning up architecture, debugging production issues, improving performance, building admin tools, connecting APIs, and getting stalled delivery moving again."
  },
  {
    question: "Do you work on Shopify and e-commerce systems?",
    answer: "Yes. I work on Shopify-connected Rails apps, custom Shopify workflows, webhooks, fulfillment tools, commission systems, reporting, and revenue operations."
  },
  {
    question: "Do you offer ongoing technical leadership help?",
    answer: "Yes, when that is what the business needs. I can help with roadmap tradeoffs, architecture, vendor choices, scope, delivery, and technical decisions."
  }
] %>
<% faq_schema = {
  "@context" => "https://schema.org",
  "@type" => "FAQPage",
  "mainEntity" => faq_items.map { |item|
    {
      "@type" => "Question",
      "name" => item[:question],
      "acceptedAnswer" => {
        "@type" => "Answer",
        "text" => item[:answer]
      }
    }
  }
} %>
<% content_for :head do %>
  <script type="application/ld+json"><%= raw(faq_schema.to_json) %></script>
<% end %>

<section class="section-block">
  <div class="section-shell">
    <div class="hero-grid">
      <div class="rise-in">
        <p class="pill">FAQ</p>
        <h1 class="mt-5 text-4xl font-bold leading-tight text-slate-900 sm:text-5xl">Common questions before we work together.</h1>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-slate-700">If you are comparing automation help, Rails consulting, Shopify work, internal tools, or ongoing technical support, this should help you sort out the basics.</p>
        <p class="mt-3 max-w-2xl text-base leading-relaxed text-slate-700">The short version: I am a fit when an important workflow needs clearer technical thinking and someone who can actually build the fix.</p>
      </div>

      <div class="rise-in">
        <%= render "inquiries/quick_form_cta" %>
      </div>
    </div>
  </div>
</section>

<section class="section-block pt-0">
  <div class="section-shell max-w-5xl">
    <div class="grid gap-4 lg:grid-cols-2">
      <% faq_items.each_with_index do |item, index| %>
        <details class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm" <%= "open" if index.zero? %>>
          <summary class="cursor-pointer text-base font-semibold text-slate-900"><%= item[:question] %></summary>
          <p class="mt-3 text-sm leading-relaxed text-slate-700"><%= item[:answer] %></p>
        </details>
      <% end %>
    </div>

    <div class="mt-10 rounded-2xl border border-slate-300 bg-white p-6">
      <h2 class="text-2xl font-bold text-slate-900">Still not sure what you need?</h2>
      <p class="mt-3 text-slate-700">That is normal. A lot of useful software work starts by naming the problem clearly.</p>
      <%= link_to "Get started", start_project_path, class: "btn-primary mt-5" %>
    </div>
  </div>
</section>
