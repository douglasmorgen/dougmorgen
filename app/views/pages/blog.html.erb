<% content_for :meta_title, "Doug Morgen Blog | Rails, Shopify, Automation, and CTO Notes" %>
<% content_for :meta_description, "Writing from Doug Morgen on Rails delivery, Shopify operations, workflow automation, and pragmatic fractional CTO execution." %>

<section class="section-block">
  <div class="section-shell max-w-4xl">
    <h1 class="text-4xl font-bold text-slate-900 sm:text-5xl">Blog</h1>
    <p class="mt-4 text-lg text-slate-700">Notes from real builds: Rails delivery, Shopify operations, automation, and product execution.</p>

    <div class="mt-10 space-y-5">
      <article class="card">
        <h2 class="text-xl font-bold text-slate-900">No filler posts</h2>
        <p class="mt-3 text-slate-700">I publish when I have something concrete and useful to share from client work. If you want to talk through a specific problem now, reach out directly.</p>
      </article>
    </div>

    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <%= link_to "Start a project", start_project_path, class: "btn-primary" %>
      <%= link_to "View work", work_path, class: "btn-secondary" %>
    </div>
  </div>
</section>
