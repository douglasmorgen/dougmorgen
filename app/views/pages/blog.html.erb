<% content_for :meta_title, "Doug Morgen Notes on SMB Automation, Rails, and Shopify" %>
<% content_for :meta_description, "Notes from Doug Morgen on automation, Rails delivery, Shopify operations, workflow software, and practical product execution." %>
<% content_for :meta_robots, "noindex,follow" %>

<section class="section-block">
  <div class="section-shell">
    <div class="hero-grid">
      <div class="rise-in">
        <p class="pill">Notes</p>
        <h1 class="mt-5 text-4xl font-bold leading-tight text-slate-900 sm:text-5xl">Notes are coming. Useful help is available now.</h1>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-slate-700">I do not want this to be a thin blog page. Until there are real posts here, this page is intentionally kept out of search results.</p>
        <p class="mt-3 max-w-2xl text-base leading-relaxed text-slate-700">If you are here because you need automation, Rails, Shopify, internal tools, or integration help, start with the form and I will reply with next steps.</p>

        <div class="mt-7 flex flex-col gap-3 sm:flex-row">
          <%= link_to "See services", services_path, class: "btn-secondary" %>
          <%= link_to "View work", work_path, class: "btn-secondary" %>
        </div>
      </div>

      <div class="rise-in">
        <%= render "inquiries/quick_form_cta" %>
      </div>
    </div>
  </div>
</section>

<section class="section-block pt-0">
  <div class="section-shell max-w-4xl">
    <article class="card">
      <h2 class="text-2xl font-bold text-slate-900">Why this page is not indexed yet</h2>
      <p class="mt-3 text-slate-700">Search should send people to pages that are useful today: services, work, FAQ, and the home page. This notes page can become indexable once it has real articles.</p>
    </article>
  </div>
</section>
