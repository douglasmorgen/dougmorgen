<% content_for :meta_title, "SMB Automation and Software Consulting Services | Doug Morgen" %>
<% content_for :meta_description, "Automation, Rails apps, Shopify tools, internal software, API integrations, data cleanup, and senior technical help for SMBs." %>

<section class="section-block">
  <div class="section-shell">
    <div class="hero-grid">
      <div class="rise-in">
        <p class="pill">Services</p>
        <h1 class="mt-5 text-4xl font-bold leading-tight text-slate-900 sm:text-5xl">Software help for businesses with messy operations.</h1>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-slate-700">I help teams automate manual work, connect systems, build internal tools, improve Rails apps, and make Shopify operations smoother.</p>
        <p class="mt-3 max-w-2xl text-base leading-relaxed text-slate-700">Sometimes the right answer is a scoped build. Sometimes it is ongoing senior help. Either way, the goal is to make the business run better.</p>

        <div class="mt-7 flex flex-col gap-3 sm:flex-row">
          <%= link_to "See case studies", work_path, class: "btn-secondary" %>
          <%= link_to "Read common questions", faq_path, class: "btn-secondary" %>
        </div>
      </div>

      <div class="rise-in">
        <%= render "inquiries/quick_form_cta" %>
      </div>
    </div>
  </div>
</section>

<section class="section-block pt-0">
  <div class="section-shell">
    <h2 class="text-2xl font-bold text-slate-900 sm:text-3xl">Ways I can help</h2>

    <div class="mt-6 grid gap-6 md:grid-cols-2">
      <article class="card">
        <h3 class="text-xl font-bold text-slate-900">Business process automation</h3>
        <p class="mt-3 text-slate-700">Replace recurring spreadsheet work, approvals, and handoffs with workflows your team can trust.</p>
      </article>

      <article class="card">
        <h3 class="text-xl font-bold text-slate-900">Internal tools and dashboards</h3>
        <p class="mt-3 text-slate-700">Build admin screens, reports, dashboards, and custom tools around how the business actually works.</p>
      </article>

      <article class="card">
        <h3 class="text-xl font-bold text-slate-900">Rails application consulting</h3>
        <p class="mt-3 text-slate-700">Ship features, clean up architecture, improve performance, debug production issues, and get stalled Rails work moving again.</p>
      </article>

      <article class="card">
        <h3 class="text-xl font-bold text-slate-900">Shopify and e-commerce systems</h3>
        <p class="mt-3 text-slate-700">Custom Shopify apps, order workflows, fulfillment tools, customer operations, webhooks, and reporting around your storefront.</p>
      </article>

      <article class="card">
        <h3 class="text-xl font-bold text-slate-900">API integrations and data cleanup</h3>
        <p class="mt-3 text-slate-700">Connect the systems your business runs on, clean up imports, build reliable syncs, and make reporting easier to trust.</p>
      </article>

      <article class="card">
        <h3 class="text-xl font-bold text-slate-900">Ongoing technical leadership</h3>
        <p class="mt-3 text-slate-700">Get senior help with roadmap tradeoffs, architecture, vendor choices, scope, and technical priorities without hiring full-time.</p>
      </article>
    </div>
  </div>
</section>

<section class="section-block bg-slate-50/80">
  <div class="section-shell">
    <div class="card">
      <h2 class="text-2xl font-bold text-slate-900">Ways to work together</h2>
      <div class="mt-5 grid gap-5 lg:grid-cols-3">
        <div>
          <p class="font-semibold text-slate-900">Workflow review</p>
          <p class="mt-2 text-sm leading-relaxed text-slate-700">A focused first pass to understand the problem, spot risks, and decide what should happen next.</p>
        </div>
        <div>
          <p class="font-semibold text-slate-900">Scoped build or cleanup</p>
          <p class="mt-2 text-sm leading-relaxed text-slate-700">A clear project to automate the flow, connect the systems, clean the data, or ship the feature.</p>
        </div>
        <div>
          <p class="font-semibold text-slate-900">Ongoing technical partner</p>
          <p class="mt-2 text-sm leading-relaxed text-slate-700">Regular senior help when you need both technical judgment and hands-on implementation.</p>
        </div>
      </div>
      <div class="mt-6">
        <%= link_to "Get started", start_project_path, class: "btn-primary" %>
      </div>
    </div>
  </div>
</section>
