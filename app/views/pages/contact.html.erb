<% content_for :meta_title, "Talk to Doug Morgen About Automation or Software Work" %>
<% content_for :meta_description, "Contact Doug Morgen for automation, Rails consulting, Shopify systems, internal tools, API integrations, data cleanup, and senior technical help." %>

<section class="section-block">
  <div class="section-shell">
    <div class="hero-grid">
      <div class="rise-in">
        <p class="pill">Get started</p>
        <h1 class="mt-5 text-4xl font-bold leading-tight text-slate-900 sm:text-5xl">Tell me what you want to build, automate, or fix.</h1>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-slate-700">Start with the form. Share the workflow, system, data problem, integration, or software decision that needs attention.</p>
        <p class="mt-3 max-w-2xl text-base leading-relaxed text-slate-700">I review each message personally and reply with next steps.</p>

        <div class="mt-8 grid gap-4 sm:grid-cols-2">
          <div class="rounded-xl border border-slate-200 bg-white p-5">
            <p class="font-semibold text-slate-900">Prefer LinkedIn?</p>
            <%= link_to "Connect with me", linkedin_url, target: "_blank", rel: "noopener", class: "mt-3 inline-block text-sm font-semibold text-blue-700 underline decoration-slate-300 hover:text-blue-800" %>
          </div>
          <div class="rounded-xl border border-slate-200 bg-white p-5">
            <p class="font-semibold text-slate-900">Want a little more context?</p>
            <%= link_to "Read the FAQ", faq_path, class: "mt-3 inline-block text-sm font-semibold text-blue-700 underline decoration-slate-300 hover:text-blue-800" %>
          </div>
        </div>
      </div>

      <div class="rise-in">
        <%= render "inquiries/quick_form_cta" %>
      </div>
    </div>
  </div>
</section>
